{
  "manifest_version": 3,
  "name": "Copy URL From Context Menu",
  "version": "1.5.0",
  "description": "Copies the clicked tab or page URL and shows a confirmation notification.",
  "permissions": [
    "contextMenus",
    "notifications",
    "offscreen",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}