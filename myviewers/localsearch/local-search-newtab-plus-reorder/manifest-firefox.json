{
  "manifest_version": 2,
  "name": "Local Search New Tab Plus",
  "version": "1.3.3",
  "description": "Local new tab page with quick links, custom search engines, notes, import/export, and reorder controls.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "https://127.0.0.1/*",
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": ["background-firefox.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    "redirect.html",
    "newtab.html",
    "notes.html"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-search-newtab-plus@corkiejp.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}