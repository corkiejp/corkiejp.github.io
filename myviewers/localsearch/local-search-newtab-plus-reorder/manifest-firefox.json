{
  "manifest_version": 2,
  "name": "Local Search New Tab Plus (Firefox)",
  "version": "1.3.0",
  "description": "Local new tab page with quick links, custom search engines, import/export, and reorder controls.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "https://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background-firefox.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    "redirect.html"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-search-newtab-plus@example.com",
      "strict_min_version": "113.0"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
