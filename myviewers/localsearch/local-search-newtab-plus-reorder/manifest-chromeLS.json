{
  "manifest_version": 3,
  "name": "Local Search New Tab Plus (Chrome with LS)",
  "version": "1.3.3",
  "description": "Local new tab page with quick links, custom search engines, notes, import/export, and reorder controls.",
  "permissions": ["storage", "declarativeNetRequest", "contextMenus", "tabs"],
  "host_permissions": ["https://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "LocalBlank",
      "search_url": "https://127.0.0.1/?q={searchTerms}",
      "keyword": "localblank",
      "favicon_url": "https://corkiejp.github.io/myviewers/localsearch/local-search-newtab-plus-reorder/assets/icon32.png",
      "is_default": false,
	  "encoding": "UTF-8"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["redirect.html", "newtab.html", "notes.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
