{
  "manifest_version": 3,
  "name": "AT Protocol Handler",
  "version": "1.12",
  "description": "Brings an Android style share to PWA workflow for AT links onto desktop.",
  "omnibox": { "keyword": "at" },

  "background": {
    "service_worker": "background.js"
  },
  
    "action": {
    "default_popup": "inst.html"
  },
"permissions": [
  "storage"
],
"options_ui": {
  "page": "options.html",
  "open_in_tab": true
},  


  "host_permissions": [
    "https://bsky.app/*",
    "https://deer.social/*",
    "https://klearsky.pages.dev/*",
    "https://wsocial.eu/*",
    "https://mu.social/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://deer.social/*",
        "https://klearsky.pages.dev/*",
		"https://wsocial.eu/*",
		"https://mu.social/*"
      ],
      "js": ["content.js"]
    }
  ]
}