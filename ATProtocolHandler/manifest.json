{
  "manifest_version": 3,
  "name": "AT Protocol Handler",
  "version": "1.11",
  "description": "Brings an Android style share to PWA workflow for AT links onto desktop.",
  "omnibox": { "keyword": "at" },

  "background": {
    "service_worker": "background.js"
  },
  
    "action": {
    "default_popup": "inst.html"
  },


  "host_permissions": [
    "https://bsky.app/*",
    "https://deer.social/*",
    "https://klearsky.pages.dev/*",
    "https://wsocial.eu/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://deer.social/*",
        "https://klearsky.pages.dev/*",
		"https://wsocial.eu/*"
      ],
      "js": ["content.js"]
    }
  ]
}