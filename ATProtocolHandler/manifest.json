{
  "manifest_version": 3,
  "name": "AT Protocol Handler",
  "version": "1.14",
  "description": "AT Protocol utilities: handle tools, post filtering, PDS info.",
  "permissions": [
    "storage",
    "omnibox"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wsocial.eu/*",
        "https://bsky.app/*",
        "https://mu.social/*",
        "https://deer.social/*",
        "https://blacksky.community/*",
        "https://northsky.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pdsls.dev/*"
      ],
      "js": ["pdsls-editor.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "inst.html"
  },
  "omnibox": {
    "keyword": "at"
  }
}