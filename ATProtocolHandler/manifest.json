{
  "manifest_version": 3,
  "name": "AT Protocol Handler",
  "version": "1.05",
  "description": "Lists sites that accept at://did:plc... URLs",
  "omnibox": { "keyword": "at" },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "inst.html"
  },
  "permissions": [],
  "host_permissions": [
    "https://bsky.app/*",
    "https://deer.social/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://deer.social/*"
      ],
      "js": ["content.js"]
    }
  ]
}
