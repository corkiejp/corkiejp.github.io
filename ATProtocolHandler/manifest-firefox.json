{
  "manifest_version": 3,
  "name": "AT Protocol Handler",
  "version": "1.1.1",
  "description": "Brings an Android-style share-to-PWA workflow for AT links onto desktop.",
  "action": {
    "default_popup": "inst.html"
  },
  "permissions": [
    "tabs",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://bsky.app/*",
    "https://deer.social/*",
    "https://klearsky.pages.dev/*",
    "https://wsocial.eu/*"
  ],
  "omnibox": {
    "keyword": "at"
  },
"background": {
  "scripts": ["background.js"]
},
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://deer.social/*",
        "https://klearsky.pages.dev/*",
        "https://wsocial.eu/*"
      ],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "corkiejp@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}